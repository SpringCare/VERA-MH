.env
__pycache__
.venv

# Default output (p_* runs, nested evaluations, scores)
output/

# Legacy output folders
conversations/
evaluations/
logging/
logs/

# Except in the full-run replay's committed slice, which mirrors a run's layout:
# its saved conversations and judge logs, and the baseline seeded from them.
# The full run and its baseline stay local, under output/.
!tests/fixtures/full_run/**/conversations/
!tests/fixtures/full_run/**/evaluations/
!tests/fixtures/full_run/**/logs/

# Track publication_data
!publication_data/
!publication_data/**
tmp_tests/
**/.DS_Store
.ipynb_checkpoints/
*.ipynb
.vscode
spring_scripts/

# Testing artifacts
.pytest_cache/
.coverage
coverage.json
htmlcov/
!tests/fixtures/conversations/

# IDEs
.cursor/
.vscode/

# Claude Code - personal settings and local files only
.claude/settings.local.json
.claude/hooks/local/
.claude/commands/local/
.claude/logs/

#MPC
.serena

# scoring artifacts
publication_evaluations/vera_mh_v1_scores/
publication_conversations/vera_mh_v1_scores_conversations/
score_comparisons/
score_comparisons/**
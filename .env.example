ANTHROPIC_API_KEY=your_anthropic_api_key_here

OPENAI_API_KEY=your_openai_api_key_here

GOOGLE_API_KEY=your_google_api_key_here

AZURE_API_KEY=your_azure_api_key_here
AZURE_ENDPOINT=your_azure_endpoint_here
AZURE_API_VERSION=your_azure_api_version_here

ENDPOINT_URL=http://0.0.0.0:8000/api/chat
ENDPOINT_START_URL=http://0.0.0.0:8000/api/start_conversation
ENDPOINT_API_KEY=your_endpoint_api_key_here

# Optional: route Claude/OpenAI/Gemini calls through a proxy or gateway
# (e.g. LiteLLM) instead of the providers' public APIs. Leave these unset to
# call the providers directly. API_BASE_URL applies to all three; the
# per-provider vars override it. When you set one, the matching *_API_KEY must
# be a key the gateway accepts, not a provider key.
# API_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# GOOGLE_BASE_URL=https://your-gateway.example.com